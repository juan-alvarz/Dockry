<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.juan-alvarz.Dockry</string>
	<key>CFBundleName</key>
	<string>Dockry</string>
	<key>CFBundleExecutable</key>
	<string>Dockry</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Menu bar app: no icon in the Dock. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Shown when macOS asks to let Dockry control Spotify (album art and playback controls). -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Dockry shows what Spotify is playing and controls playback from the dock.</string>
	<!-- Shown when macOS asks for the location, for the weather widget. -->
	<key>NSLocationUsageDescription</key>
	<string>Dockry shows the weather where you are. It only needs your town.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Dockry shows the weather where you are. It only needs your town.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
